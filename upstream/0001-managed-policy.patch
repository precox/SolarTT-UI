new file mode 100644
--- /dev/null
+++ b/lib/src/managed.rs
@@ -0,0 +1,80 @@
+//! Optional host policy; database and monthly quota semantics belong to the embedding agent.
+use crate::authentication::Source;
+use async_trait::async_trait;
+use std::{io, sync::Arc};
+use tokio::sync::watch;
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Identity {
+    pub user_id: String,
+    pub credential_id: String,
+    pub generation: u64,
+}
+
+pub trait Permit: Send {
+    fn amount(&self) -> usize;
+    fn begin(&mut self);
+    fn finish(self: Box<Self>, accepted: usize) -> io::Result<()>;
+}
+
+#[async_trait]
+pub trait Session: Send + Sync {
+    fn identity(&self) -> &Identity;
+    fn is_cancelled(&self) -> bool;
+    async fn cancelled(&self);
+    async fn reserve(&self, bytes: usize, datagram: bool) -> io::Result<Box<dyn Permit>>;
+}
+
+pub trait Policy: Send + Sync {
+    fn allows_destination(&self, _ip: std::net::IpAddr) -> bool {
+        true
+    }
+    fn resolve(&self, source: &Source<'_>) -> io::Result<Identity>;
+    fn open(&self, identity: Identity) -> io::Result<Arc<dyn Session>>;
+}
+
+pub(crate) struct Scope {
+    policy: Option<Arc<dyn Policy>>,
+    binding: watch::Sender<Option<Arc<dyn Session>>>,
+}
+
+impl Scope {
+    pub(crate) fn new(policy: Option<Arc<dyn Policy>>) -> Self {
+        let (binding, _) = watch::channel(None);
+        Self { policy, binding }
+    }
+    pub(crate) fn bind(&self, source: &Source<'_>) -> io::Result<()> {
+        let Some(policy) = &self.policy else {
+            return Ok(());
+        };
+        let identity = policy.resolve(source)?;
+        let current = self.binding.borrow().clone();
+        if let Some(session) = current {
+            if session.identity() != &identity || session.is_cancelled() {
+                return Err(io::Error::new(
+                    io::ErrorKind::PermissionDenied,
+                    "Managed identity rejected",
+                ));
+            }
+        } else {
+            self.binding.send_replace(Some(policy.open(identity)?));
+        }
+        Ok(())
+    }
+    pub(crate) fn session(&self) -> Option<Arc<dyn Session>> {
+        self.binding.borrow().clone()
+    }
+    pub(crate) async fn cancelled(&self) {
+        let mut rx = self.binding.subscribe();
+        loop {
+            let session = rx.borrow_and_update().clone();
+            if let Some(session) = session {
+                session.cancelled().await;
+                return;
+            }
+            if rx.changed().await.is_err() {
+                std::future::pending::<()>().await;
+            }
+        }
+    }
+}
