+
+// Keep the upstream HTTP/1 and forwarding API stable while using maintained h2/http.
+// Copy raw header values and append each occurrence, including duplicate headers.
+fn legacy_request(parts: http1::request::Parts) -> io::Result<RequestHeaders> {
+    let mut request = http::Request::new(()).into_parts().0;
+    request.method = http::Method::from_bytes(parts.method.as_str().as_bytes())
+        .map_err(|_| io::Error::other("Invalid H2 method"))?;
+    request.uri = parts
+        .uri
+        .to_string()
+        .parse()
+        .map_err(|_| io::Error::other("Invalid H2 URI"))?;
+    request.version = http::Version::HTTP_2;
+    for (name, value) in &parts.headers {
+        request.headers.append(
+            http::header::HeaderName::from_bytes(name.as_str().as_bytes())
+                .map_err(|_| io::Error::other("Invalid H2 header name"))?,
+            http::HeaderValue::from_bytes(value.as_bytes())
+                .map_err(|_| io::Error::other("Invalid H2 header value"))?,
+        );
+    }
+    Ok(request)
+}
+fn current_response(parts: ResponseHeaders) -> io::Result<http1::Response<()>> {
+    let mut response = http1::Response::new(());
+    *response.status_mut() = http1::StatusCode::from_u16(parts.status.as_u16())
+        .map_err(|_| io::Error::other("Invalid H2 response status"))?;
+    *response.version_mut() = http1::Version::HTTP_2;
+    for (name, value) in &parts.headers {
+        response.headers_mut().append(
+            http1::header::HeaderName::from_bytes(name.as_str().as_bytes())
+                .map_err(|_| io::Error::other("Invalid H2 response header name"))?,
+            http1::HeaderValue::from_bytes(value.as_bytes())
+                .map_err(|_| io::Error::other("Invalid H2 response header value"))?,
+        );
+    }
+    Ok(response)
+}
+
+#[cfg(test)]
+mod compatibility_tests {
+    use super::*;
+    #[test]
+    fn h2_bridge_preserves_method_uri_status_and_duplicate_binary_headers() {
+        let mut input = http1::Request::builder()
+            .method("CONNECT")
+            .uri("example.org:443")
+            .body(())
+            .unwrap();
+        for value in [b"first".as_slice(), &[0x80, 0xff]] {
+            input
+                .headers_mut()
+                .append("x-fixture", http1::HeaderValue::from_bytes(value).unwrap());
+        }
+        let request = legacy_request(input.into_parts().0).unwrap();
+        assert_eq!(request.method, http::Method::CONNECT);
+        assert_eq!(request.uri.authority().unwrap().as_str(), "example.org:443");
+        assert_eq!(request.version, http::Version::HTTP_2);
+        let values: Vec<_> = request
+            .headers
+            .get_all("x-fixture")
+            .iter()
+            .map(|v| v.as_bytes())
+            .collect();
+        assert_eq!(values, vec![b"first".as_slice(), &[0x80, 0xff]]);
+        let mut output = http::Response::builder().status(407).body(()).unwrap();
+        for value in request.headers.get_all("x-fixture").iter() {
+            output.headers_mut().append("x-fixture", value.clone());
+        }
+        let response = current_response(output.into_parts().0).unwrap();
+        assert_eq!(
+            response.status(),
+            http1::StatusCode::PROXY_AUTHENTICATION_REQUIRED
+        );
+        assert_eq!(response.version(), http1::Version::HTTP_2);
+        assert_eq!(
+            response
+                .headers()
+                .get_all("x-fixture")
+                .iter()
+                .map(|v| v.as_bytes())
+                .collect::<Vec<_>>(),
+            values
+        );
+    }
+}
