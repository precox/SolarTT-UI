[Unit]
Description=Independent TrustTunnel watcher freshness and Telegram alerts
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
StateDirectory=solartt-upstream-monitor
StateDirectoryMode=0700
LoadCredential=telegram_token:/etc/solartt-upstream-monitor/telegram_token
LoadCredential=telegram_chat_id:/etc/solartt-upstream-monitor/telegram_chat_id
LoadCredential=github_token:/etc/solartt-upstream-monitor/github_token
ExecStart=/usr/bin/python3 -B /opt/solartt-upstream-monitor/notify_trusttunnel_telegram.py
TimeoutStartSec=210
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryMax=128M
MemorySwapMax=0
CPUQuota=10%
TasksMax=8
Nice=10
IOSchedulingClass=idle
