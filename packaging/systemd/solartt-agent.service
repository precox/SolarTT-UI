[Unit]
Description=SolarTT managed TrustTunnel endpoint
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=solartt-agent
Group=solartt-control
SupplementaryGroups=solartt-agent
ExecStart=/usr/bin/solartt-agent /etc/solartt/agent.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077
StateDirectory=solartt
StateDirectoryMode=0700
RuntimeDirectory=solartt
RuntimeDirectoryMode=0750
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# getifaddrs() uses route netlink to read assigned addresses for destination denial.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
[Install]
WantedBy=multi-user.target
